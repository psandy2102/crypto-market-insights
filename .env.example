APP_ENV=development
APP_TIMEZONE=America/Toronto
DATABASE_URL=postgresql+psycopg://crypto_insights:change-this-local-password@localhost:5432/crypto_insights
POSTGRES_DB=crypto_insights
POSTGRES_USER=crypto_insights
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
MARKET_METADATA_PROVIDER=coingecko
MARKET_DATA_VENUE=kraken
DEFAULT_QUOTE_CURRENCY=USD
# Optional CoinGecko Demo API key. Recheck current terms and limits; attribute published data
# according to CoinGecko's data-use and branding guidance.
COINGECKO_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=0
OLLAMA_TOP_P=0.9
OLLAMA_SEED=42
OLLAMA_NUM_PREDICT=512
DAILY_ANALYSIS_TIME=08:00
UNIVERSE_SIZE=10
UNIVERSE_MIN_MARKET_CAP=100000000
UNIVERSE_MIN_QUOTE_VOLUME=10000000
UNIVERSE_MIN_HISTORY_CANDLES=200
UNIVERSE_HISTORY_TIMEFRAME=1d
UNIVERSE_MAX_METADATA_AGE_HOURS=24
UNIVERSE_MAX_HISTORY_AGE_HOURS=26
UNIVERSE_MIN_DATA_QUALITY=90
RISK_MAX_CANDLE_AGE_HOURS=26
RISK_MIN_QUOTE_VOLUME=10000000
RISK_MIN_LIQUIDITY_SCORE=60
RISK_MAX_ATR_TO_CLOSE=0.20
RISK_MIN_POST_COST_REWARD_RISK=1.50
RISK_SETUP_EXPIRY_HOURS=24
RSS_FEEDS=
RSS_POLL_INTERVAL_MINUTES=30
RSS_STALE_AFTER_MINUTES=1440
NEWS_EXCERPT_CHARS=500
